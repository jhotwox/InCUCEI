{
  "expo": {
    "name": "InCUCEI",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "incucei",
    "splash": {
      "image": "./assets/newsplash.png",
      // "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jhotwox.client.production"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jhotwox.client.production",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font"
      ],
      "expo-notifications",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1IjoiZ2Vyc29uMzAiLCJhIjoiY21tN2NucDV3MHIzMTJvb3V0OWtmNG83MiJ9.0wA2pkWyqm5KveHU_DNJ7g"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show current location on map."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/newsplash.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./assets/newsplash.png",
            "resizeMode": "contain"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "834be67a-1814-4c1a-affc-0a412e5ee67d"
      }
    }
  }
}
